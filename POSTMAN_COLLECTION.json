        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Updated College\",\"state\":\"Karnataka\",\"city\":\"Mysuru\",\"fees\":175000,\"ranking\":120,\"hostelAvailable\":true}"
        },
        "url": "{{baseUrl}}/admin/colleges/{{collegeId}}"
      }
    },
    {
      "name": "Admin delete college",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
