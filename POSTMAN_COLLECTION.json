{
  "info": {
    "name": "CollegeWise API",
    "description": "Set token to the token returned by login. Student routes need a student token; admin routes need an environment-provisioned admin token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "collegeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Register student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Demo Student\",\"email\":\"student@example.com\",\"password\":\"change-this-password\"}"
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"student@example.com\",\"password\":\"change-this-password\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Logout (discard client token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/auth/logout"
      }
    },
    {
      "name": "College list with filters",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/colleges?page=0&size=12&q=demo&state=Karnataka&maxFees=250000&hostel=true&sort=fees"
      }
    },
    {
      "name": "College search",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/colleges/search?q=engineering&page=0&size=12"
      }
    },
    {
      "name": "College details",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/colleges/{{collegeId}}"
      }
    },
    {
      "name": "Get student profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/students/profile"
      }
    },
    {
      "name": "Update student profile",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"tenthPercentage\":85,\"twelfthPercentage\":91,\"entranceExam\":\"JEE Main\",\"examYear\":2025,\"rank\":18000,\"percentile\":96.2,\"category\":\"OPEN\",\"preferredCourse\":\"B.Tech\",\"preferredBranch\":\"Computer Science and Engineering\",\"preferredState\":\"Karnataka\",\"maximumBudget\":250000,\"hostelRequired\":true,\"careerInterest\":\"Data science\"}"
        },
        "url": "{{baseUrl}}/students/profile"
      }
    },
    {
      "name": "Recommendations",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/students/recommendations"
      }
    },
    {
      "name": "Recommendation history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/students/recommendations/history"
      }
    },
    {
      "name": "List favorites",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/students/favorites"
      }
    },
    {
      "name": "Add favorite",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/students/favorites/{{collegeId}}"
      }
    },
    {
      "name": "Remove favorite",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/students/favorites/{{collegeId}}"
      }
    },
    {
      "name": "Compare colleges",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/students/compare?ids=1&ids=2"
      }
    },
    {
      "name": "Admin dashboard",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/admin/dashboard"
      }
    },
    {
      "name": "Admin create college",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"New College\",\"state\":\"Karnataka\",\"city\":\"Mysuru\",\"fees\":150000,\"ranking\":125,\"hostelAvailable\":true}"
        },
        "url": "{{baseUrl}}/admin/colleges"
      }
    },
    {
      "name": "Admin update college",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
